{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rwb-hack.invalid/contracts/agents/v1/common.schema.json",
  "title": "Reusable definitions for agent contract 1.0",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "fr_id": {
      "type": "string",
      "pattern": "^FR-[0-9]{3,}$(?![\\s\\S])"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$(?![\\s\\S])"
    },
    "contract_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 128
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$(?![\\s\\S])"
    },
    "checksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "evidence": {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "requirements",
            "answer"
          ]
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "question_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source",
        "quote",
        "question_id"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "answer"
              }
            }
          },
          "then": {
            "properties": {
              "question_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          },
          "else": {
            "properties": {
              "question_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "finding": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "https://rwb-hack.invalid/contracts/agents/v1/common.schema.json#/$defs/evidence"
          },
          "minItems": 1
        }
      },
      "required": [
        "text",
        "evidence"
      ],
      "additionalProperties": false
    },
    "question": {
      "type": "object",
      "properties": {
        "question_id": {
          "type": "string",
          "format": "uuid"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "related_fr_ids": {
          "type": "array",
          "items": {
            "$ref": "https://rwb-hack.invalid/contracts/agents/v1/common.schema.json#/$defs/fr_id"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "required": {
          "type": "boolean"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "answer": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 10000
        }
      },
      "required": [
        "question_id",
        "reason",
        "related_fr_ids",
        "required",
        "question"
      ],
      "additionalProperties": false
    },
    "answer": {
      "type": "object",
      "properties": {
        "question_id": {
          "type": "string",
          "format": "uuid"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 10000
        }
      },
      "required": [
        "question_id",
        "value"
      ],
      "additionalProperties": false
    },
    "assumption": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ASM-[0-9]{3,}$(?![\\s\\S])"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "related_fr_ids": {
          "type": "array",
          "items": {
            "$ref": "https://rwb-hack.invalid/contracts/agents/v1/common.schema.json#/$defs/fr_id"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "text",
        "reason",
        "related_fr_ids"
      ],
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,79}$(?![\\s\\S])"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "related_fr_ids": {
          "type": "array",
          "items": {
            "$ref": "https://rwb-hack.invalid/contracts/agents/v1/common.schema.json#/$defs/fr_id"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "artifact_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "code",
        "message",
        "severity",
        "retryable",
        "related_fr_ids"
      ],
      "additionalProperties": false
    },
    "model_call": {
      "type": "object",
      "properties": {
        "call_id": {
          "type": "string",
          "format": "uuid"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "outcome": {
          "enum": [
            "succeeded",
            "failed",
            "timeout",
            "cancelled"
          ]
        },
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "call_id",
        "model",
        "outcome",
        "input_tokens",
        "output_tokens",
        "duration_seconds"
      ],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "calls": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "model_calls": {
          "type": "array",
          "items": {
            "$ref": "https://rwb-hack.invalid/contracts/agents/v1/common.schema.json#/$defs/model_call"
          },
          "minItems": 0
        }
      },
      "required": [
        "calls",
        "input_tokens",
        "output_tokens",
        "duration_seconds",
        "model_calls"
      ],
      "additionalProperties": false
    },
    "artifact_metadata": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "format": "uuid"
        },
        "attempt_id": {
          "type": "string",
          "format": "uuid"
        },
        "path": {
          "$ref": "https://rwb-hack.invalid/contracts/agents/v1/common.schema.json#/$defs/relative_path"
        },
        "kind": {
          "$ref": "https://rwb-hack.invalid/contracts/agents/v1/common.schema.json#/$defs/identifier"
        },
        "media_type": {
          "type": "string",
          "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$(?![\\s\\S])"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "schema_version": {
          "const": "1.0"
        },
        "author_agent": {
          "$ref": "https://rwb-hack.invalid/contracts/agents/v1/common.schema.json#/$defs/identifier"
        },
        "checksum": {
          "$ref": "https://rwb-hack.invalid/contracts/agents/v1/common.schema.json#/$defs/checksum"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "related_fr_ids": {
          "type": "array",
          "items": {
            "$ref": "https://rwb-hack.invalid/contracts/agents/v1/common.schema.json#/$defs/fr_id"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "artifact_id",
        "attempt_id",
        "path",
        "kind",
        "media_type",
        "version",
        "schema_version",
        "author_agent",
        "checksum",
        "size_bytes",
        "related_fr_ids"
      ]
    },
    "artifact_reference": {
      "$ref": "#/$defs/artifact_metadata",
      "unevaluatedProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_calls": {
          "type": "integer",
          "minimum": 0
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_critical_questions": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "max_calls",
        "max_output_tokens"
      ],
      "additionalProperties": false
    }
  }
}
