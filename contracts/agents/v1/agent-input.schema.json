{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rwb-hack.invalid/contracts/agents/v1/agent-input.schema.json",
  "title": "AgentInput 1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "stage_id": {
      "$ref": "https://rwb-hack.invalid/contracts/agents/v1/common.schema.json#/$defs/identifier"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "input_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "contract_version": {
      "$ref": "https://rwb-hack.invalid/contracts/agents/v1/common.schema.json#/$defs/contract_version"
    },
    "profile_id": {
      "$ref": "https://rwb-hack.invalid/contracts/agents/v1/common.schema.json#/$defs/identifier"
    },
    "limits": {
      "$ref": "https://rwb-hack.invalid/contracts/agents/v1/common.schema.json#/$defs/limits"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "stage_id",
    "attempt",
    "input_artifact_ids",
    "contract_version",
    "profile_id",
    "limits"
  ],
  "additionalProperties": false
}
