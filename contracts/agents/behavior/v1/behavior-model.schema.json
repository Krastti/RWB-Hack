{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "parent_checksum": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "contract_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "requirements_checksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "minItems": 1,
      "maxItems": 512
    },
    "identities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "minItems": 1,
      "maxItems": 512
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                },
                "type": {
                  "$ref": "#/$defs/value_type"
                }
              },
              "required": [
                "id",
                "type"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 512
          }
        },
        "required": [
          "id",
          "fields"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 512
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "entity": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                },
                "type": {
                  "$ref": "#/$defs/value_type"
                }
              },
              "required": [
                "id",
                "type"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 512
          },
          "guard_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "minItems": 1,
            "maxItems": 512
          },
          "effect_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "minItems": 0,
            "maxItems": 512
          }
        },
        "required": [
          "id",
          "entity",
          "parameters",
          "guard_ids",
          "effect_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 512
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "decision_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "kind": {
            "enum": [
              "guard",
              "effect",
              "invariant"
            ]
          },
          "entity": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "action": {
            "type": [
              "string",
              "null"
            ]
          },
          "field": {
            "type": [
              "string",
              "null"
            ]
          },
          "expression": {
            "anyOf": [
              {
                "$ref": "#/$defs/expr"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "supported",
              "unresolved",
              "unsupported"
            ]
          },
          "critical": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "fr_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "minItems": 1,
            "maxItems": 512
          },
          "ac_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "minItems": 0,
            "maxItems": 512
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "enum": [
                    "requirement",
                    "answer",
                    "assumption"
                  ]
                },
                "source_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "required": [
                "source",
                "source_id",
                "quote"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 512
          }
        },
        "required": [
          "id",
          "decision_id",
          "kind",
          "entity",
          "action",
          "field",
          "expression",
          "status",
          "critical",
          "reason",
          "fr_ids",
          "ac_ids",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 512
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fr_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "status": {
            "enum": [
              "full",
              "partial",
              "unsupported",
              "not_applicable"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "fr_id",
          "status",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 512
    },
    "bindings": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "contract_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "entities": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "fields": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "actions": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "operation_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "screen_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "element_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "public_fields": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "minItems": 0,
                    "maxItems": 512
                  }
                },
                "required": [
                  "operation_id",
                  "screen_id",
                  "element_id",
                  "public_fields"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "contract_version",
            "entities",
            "fields",
            "actions"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "version",
    "parent_checksum",
    "contract_version",
    "requirements_checksum",
    "roles",
    "identities",
    "entities",
    "actions",
    "rules",
    "coverage",
    "bindings"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rwb-hack.invalid/contracts/agents/behavior/v1/behavior-model.schema.json",
  "$defs": {
    "expr": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "literal"
            },
            "value": {
              "type": [
                "string",
                "boolean",
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "op",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "ref"
            },
            "scope": {
              "enum": [
                "state",
                "previous",
                "actor",
                "param"
              ]
            },
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "required": [
            "op",
            "scope",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "eq",
                "ne",
                "lt",
                "le",
                "gt",
                "ge",
                "and",
                "or",
                "not",
                "is_null",
                "present"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expr"
              },
              "minItems": 1,
              "maxItems": 16
            }
          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false
        }
      ]
    },
    "value_type": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "enum",
            "boolean",
            "integer",
            "identity"
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 0,
          "maxItems": 512
        },
        "minimum": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "maximum": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "nullable": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "values",
        "minimum",
        "maximum",
        "nullable"
      ],
      "additionalProperties": false
    }
  }
}
