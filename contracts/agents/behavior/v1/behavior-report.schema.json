{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "model_checksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "interpreter_version": {
      "const": "1.0.0"
    },
    "initial_state": {
      "type": "object",
      "properties": {
        "entity": {
          "type": "string"
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "boolean",
              "integer",
              "null"
            ]
          }
        }
      },
      "required": [
        "entity",
        "values"
      ],
      "additionalProperties": false
    },
    "initial_actor": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "role": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "role"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "bounds": {
      "type": "object",
      "properties": {
        "max_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "max_states": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60
        },
        "max_domain_values": {
          "type": "integer",
          "minimum": 3,
          "maximum": 64
        },
        "max_scenarios": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      },
      "required": [
        "max_depth",
        "max_states",
        "timeout_seconds",
        "max_domain_values",
        "max_scenarios"
      ],
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "counterexample",
        "no_counterexample_within_bounds",
        "inconclusive",
        "unsupported"
      ]
    },
    "reason": {
      "type": "string"
    },
    "domain_complete": {
      "type": "boolean"
    },
    "states_visited": {
      "type": "integer",
      "minimum": 0
    },
    "transitions_checked": {
      "type": "integer",
      "minimum": 0
    },
    "trace": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "actor": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "role": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "role"
            ],
            "additionalProperties": false
          },
          "action": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "parameters": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "boolean",
                    "integer",
                    "null"
                  ]
                }
              }
            },
            "required": [
              "id",
              "parameters"
            ],
            "additionalProperties": false
          },
          "result": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "allowed",
                  "denied",
                  "unknown"
                ]
              },
              "state": {
                "type": "object",
                "properties": {
                  "entity": {
                    "type": "string"
                  },
                  "values": {
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "string",
                        "boolean",
                        "integer",
                        "null"
                      ]
                    }
                  }
                },
                "required": [
                  "entity",
                  "values"
                ],
                "additionalProperties": false
              },
              "rule_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "fr_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "status",
              "state",
              "rule_ids",
              "fr_ids",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "actor",
          "action",
          "result"
        ],
        "additionalProperties": false
      }
    },
    "invariant_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "fr_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "unknown_rules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "depth_frontier": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "model_checksum",
    "interpreter_version",
    "initial_state",
    "initial_actor",
    "bounds",
    "status",
    "reason",
    "domain_complete",
    "states_visited",
    "transitions_checked",
    "trace",
    "invariant_id",
    "fr_ids",
    "unknown_rules",
    "depth_frontier"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rwb-hack.invalid/contracts/agents/behavior/v1/behavior-report.schema.json"
}
