# Shared configuration for backend and worker.
# Set the OpenAI-compatible provider URL, model and key.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_MAX_OUTPUT_TOKENS=8000
LLM_TIMEOUT_SECONDS=120
LLM_RESPONSE_FORMAT=json_schema_compat

# Docker Compose
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
API_PORT=8000
# Optional server-approved policy file path inside the container
# PIPELINE_POLICY_FILE=/app/config/architecture-policies.local.json

FRONTEND_PORT=4200

PANEL_LOGIN=admin
PANEL_PASSWORD=

# Optional for providers supporting chat_template_kwargs (e.g. Qwen/vLLM).
# LLM_ENABLE_THINKING=false
