# Shared configuration for backend and worker.
# Set the OpenAI-compatible provider URL, model and key.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_MAX_OUTPUT_TOKENS=30000
LLM_TIMEOUT_SECONDS=60
LLM_RESPONSE_FORMAT=json_schema

# Docker Compose
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
API_PORT=8000
# Optional server-approved policy file path inside the container
# PIPELINE_POLICY_FILE=/app/templates/your-approved-policies.json

FRONTEND_PORT=4200
