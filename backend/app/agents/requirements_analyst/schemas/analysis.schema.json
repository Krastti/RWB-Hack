{
  "$defs": {
    "AcceptanceCriterion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^AC-[0-9]{3,}$",
          "title": "Id",
          "type": "string"
        },
        "related_fr_ids": {
          "items": {
            "pattern": "^FR-[0-9]{3,}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Related Fr Ids",
          "type": "array"
        },
        "given": {
          "minLength": 1,
          "title": "Given",
          "type": "string"
        },
        "when": {
          "minLength": 1,
          "title": "When",
          "type": "string"
        },
        "then": {
          "minLength": 1,
          "title": "Then",
          "type": "string"
        }
      },
      "required": [
        "id",
        "related_fr_ids",
        "given",
        "when",
        "then"
      ],
      "title": "AcceptanceCriterion",
      "type": "object"
    },
    "Assumption": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^ASM-[0-9]{3,}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "related_fr_ids": {
          "items": {
            "pattern": "^FR-[0-9]{3,}$",
            "type": "string"
          },
          "title": "Related Fr Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "text",
        "reason",
        "related_fr_ids"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "requirements",
            "answer"
          ],
          "title": "Source",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "question_id": {
          "anyOf": [
            {
              "pattern": "^Q-[0-9]{3,}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Question Id"
        }
      },
      "required": [
        "source",
        "quote",
        "question_id"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "text",
        "evidence"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FunctionalRequirement": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "pattern": "^FR-[0-9]{3,}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "text",
        "evidence",
        "id"
      ],
      "title": "FunctionalRequirement",
      "type": "object"
    },
    "NonfunctionalRequirement": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "pattern": "^NFR-[0-9]{3,}$",
          "title": "Id",
          "type": "string"
        },
        "verification": {
          "minLength": 1,
          "title": "Verification",
          "type": "string"
        }
      },
      "required": [
        "text",
        "evidence",
        "id",
        "verification"
      ],
      "title": "NonfunctionalRequirement",
      "type": "object"
    },
    "Question": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^Q-[0-9]{3,}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "critical": {
          "title": "Critical",
          "type": "boolean"
        },
        "related_fr_ids": {
          "items": {
            "pattern": "^FR-[0-9]{3,}$",
            "type": "string"
          },
          "title": "Related Fr Ids",
          "type": "array"
        },
        "answer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Answer"
        }
      },
      "required": [
        "id",
        "text",
        "reason",
        "critical",
        "related_fr_ids",
        "answer"
      ],
      "title": "Question",
      "type": "object"
    },
    "Risk": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^RISK-[0-9]{3,}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "impact": {
          "minLength": 1,
          "title": "Impact",
          "type": "string"
        },
        "related_fr_ids": {
          "items": {
            "pattern": "^FR-[0-9]{3,}$",
            "type": "string"
          },
          "title": "Related Fr Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "text",
        "impact",
        "related_fr_ids"
      ],
      "title": "Risk",
      "type": "object"
    },
    "Role": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
