          "title": "Permissions",
          "type": "array"
        }
      },
      "required": [
        "text",
        "evidence",
        "id",
        "permissions"
      ],
      "title": "Role",
      "type": "object"
    },
    "Scenario": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "pattern": "^SC-[0-9]{3,}$",
          "title": "Id",
          "type": "string"
        },
        "role_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Role Ids",
          "type": "array"
        },
        "related_fr_ids": {
          "items": {
            "pattern": "^FR-[0-9]{3,}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Related Fr Ids",
          "type": "array"
        },
        "steps": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "text",
        "evidence",
        "id",
        "role_ids",
        "related_fr_ids",
        "steps"
      ],
      "title": "Scenario",
      "type": "object"
    }
