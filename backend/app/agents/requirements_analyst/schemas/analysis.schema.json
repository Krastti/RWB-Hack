            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "pattern": "^ROLE-[0-9]{3,}$",
          "title": "Id",
          "type": "string"
        },
        "permissions": {
          "items": {
            "minLength": 1,
            "type": "string"
