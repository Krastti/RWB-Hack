{
  "$schema": "./profile.schema.json",
  "schema_version": "1.0",
  "profile_id": "russtech-fullstack",
  "profile_version": "1.0.0",
  "stack": {
    "frontend": [
      "Angular 20.1.6",
      "TypeScript",
      "Bootstrap 5.3",
      "SCSS"
    ],
    "backend": [
      "ASP.NET Core 10",
      "C# 14",
      "EF Core 10"
    ],
    "database": "PostgreSQL 17.9",
    "migrations": "EF Core migrations",
    "android": "Kotlin 2.2.21",
    "geospatial": "PostGIS (conditional)"
  },
  "contracts": {
    "agent_schema_version": "1.0",
    "json_schema_dialect": "https://json-schema.org/draft/2020-12/schema",
    "openapi_version": "3.1.0",
    "schemas": {
      "agent-input": {
        "schema_version": "1.0",
        "path": "contracts/agents/v1/agent-input.schema.json"
      },
      "agent-result": {
        "schema_version": "1.0",
        "path": "contracts/agents/v1/agent-result.schema.json"
      },
      "artifact": {
        "schema_version": "1.0",
        "path": "contracts/agents/v1/artifact.schema.json"
      },
      "requirements": {
        "schema_version": "1.0",
        "path": "contracts/agents/v1/requirements.schema.json"
      },
      "questions": {
        "schema_version": "1.0",
        "path": "contracts/agents/v1/questions.schema.json"
      },
      "architecture": {
        "schema_version": "1.0",
        "path": "contracts/agents/v1/architecture.schema.json"
      },
      "generation-plan": {
        "schema_version": "1.0",
        "path": "contracts/agents/v1/generation-plan.schema.json"
      },
      "manifest": {
        "schema_version": "1.0",
        "path": "contracts/agents/v1/manifest.schema.json"
      },
      "traceability": {
        "schema_version": "1.0",
        "path": "contracts/agents/v1/traceability.schema.json"
      },
      "common": {
        "schema_version": "1.0",
        "path": "contracts/agents/v1/common.schema.json"
      },
      "analysis-input": {
        "schema_version": "1.0",
        "path": "contracts/agents/v1/analysis-input.schema.json"
      }
    },
    "content_schema_owners": {
      "data-model.json": "A-07",
      "ui-spec.json": "A-08"
    }
  },
  "required_artifacts": [
    {
      "path": "requirements.json",
      "kind": "requirements",
      "owner": "analysis",
      "condition": "always"
    },
    {
      "path": "questions.json",
      "kind": "questions",
      "owner": "analysis",
      "condition": "always"
    },
    {
      "path": "docs/system-analysis.md",
      "kind": "system_analysis",
      "owner": "analysis",
      "condition": "always"
    },
    {
      "path": "architecture.json",
      "kind": "architecture",
      "owner": "architecture",
      "condition": "always"
    },
    {
      "path": "contracts/openapi.yaml",
      "kind": "openapi",
      "owner": "architecture",
      "condition": "always"
    },
    {
      "path": "data-model.json",
      "kind": "data_model",
      "owner": "architecture",
      "condition": "always"
    },
    {
      "path": "ui-spec.json",
      "kind": "ui_spec",
      "owner": "architecture",
      "condition": "always"
    },
    {
      "path": "generation-plan.json",
      "kind": "generation_plan",
      "owner": "architecture",
      "condition": "always"
    },
    {
      "path": "docs/product.md",
      "kind": "documentation",
      "owner": "documentation",
      "condition": "always"
    },
    {
      "path": "docs/architecture.md",
      "kind": "documentation",
      "owner": "documentation",
      "condition": "always"
    },
    {
      "path": "docs/data-model.md",
      "kind": "documentation",
      "owner": "documentation",
      "condition": "always"
    },
    {
      "path": "docs/user-guide.md",
      "kind": "documentation",
      "owner": "documentation",
      "condition": "always"
    },
    {
      "path": "docs/development-guide.md",
      "kind": "documentation",
      "owner": "documentation",
      "condition": "always"
    },
    {
      "path": "docs/limitations.md",
      "kind": "documentation",
      "owner": "documentation",
      "condition": "always"
    },
    {
      "path": "README.md",
      "kind": "documentation",
      "owner": "documentation",
      "condition": "always"
    },
    {
      "path": "traceability.json",
      "kind": "traceability",
      "owner": "assembly",
      "condition": "always"
    },
    {
      "path": "manifest.json",
      "kind": "manifest",
      "owner": "assembly",
      "condition": "always"
    },
    {
      "path": "frontend/package.json",
      "kind": "configuration",
      "owner": "frontend",
      "condition": "always"
    },
    {
      "path": "frontend/tsconfig.json",
      "kind": "configuration",
      "owner": "frontend",
      "condition": "always"
    },
    {
      "path": "frontend/src/index.html",
      "kind": "source",
      "owner": "frontend",
      "condition": "always"
    },
    {
      "path": "frontend/src/main.ts",
      "kind": "source",
      "owner": "frontend",
      "condition": "always"
    },
    {
      "path": "frontend/src/app/app.ts",
      "kind": "source",
      "owner": "frontend",
      "condition": "always"
    },
    {
      "path": "frontend/src/styles.scss",
      "kind": "source",
      "owner": "frontend",
      "condition": "always"
    },
    {
      "path": "frontend/src/app/api/client.ts",
      "kind": "source",
      "owner": "frontend",
      "condition": "always"
    },
    {
      "path": ".gitignore",
      "kind": "configuration",
      "owner": "assembly",
      "condition": "always"
    },
    {
      "path": "integrations/README.md",
      "kind": "documentation",
      "owner": "integrations",
      "condition": "has_integrations"
    },
    {
      "path": "frontend/angular.json",
      "kind": "configuration",
      "owner": "frontend",
      "condition": "always"
    },
    {
      "path": "frontend/package-lock.json",
      "kind": "configuration",
      "owner": "frontend",
      "condition": "always"
    },
    {
      "path": "frontend/tsconfig.app.json",
      "kind": "configuration",
      "owner": "frontend",
      "condition": "always"
    },
    {
      "path": "frontend/src/app/app.config.ts",
      "kind": "source",
      "owner": "frontend",
      "condition": "always"
    },
    {
      "path": "frontend/src/app/app.routes.ts",
      "kind": "source",
      "owner": "frontend",
      "condition": "always"
    },
    {
      "path": "frontend/THIRD_PARTY_NOTICES.md",
      "kind": "documentation",
      "owner": "frontend",
      "condition": "always"
    },
    {
      "path": "backend/src/App.csproj",
      "kind": "configuration",
      "owner": "backend",
      "condition": "always"
    },
    {
      "path": "backend/src/Program.cs",
      "kind": "source",
      "owner": "backend",
      "condition": "always"
    },
    {
      "path": "backend/src/appsettings.json",
      "kind": "configuration",
      "owner": "backend",
      "condition": "always"
    },
    {
      "path": "backend/src/Dockerfile",
      "kind": "configuration",
      "owner": "backend",
      "condition": "always"
    },
    {
      "path": "backend/migrations/README.md",
      "kind": "documentation",
      "owner": "migrations",
      "condition": "always"
    },
    {
      "path": "backend/migrations/Initial.cs",
      "kind": "migration",
      "owner": "migrations",
      "condition": "always"
    },
    {
      "path": "compose.yaml",
      "kind": "configuration",
      "owner": "verification",
      "condition": "always"
    },
    {
      "path": ".env.example",
      "kind": "configuration",
      "owner": "verification",
      "condition": "always"
    },
    {
      "path": ".gitlab-ci.yml",
      "kind": "configuration",
      "owner": "verification",
      "condition": "always"
    },
    {
      "path": "tests/App.Tests.csproj",
      "kind": "configuration",
      "owner": "verification",
      "condition": "always"
    },
    {
      "path": "tests/AcceptanceTests.cs",
      "kind": "source",
      "owner": "verification",
      "condition": "always"
    },
    {
      "path": "android/settings.gradle.kts",
      "kind": "configuration",
      "owner": "android",
      "condition": "has_android"
    },
    {
      "path": "android/build.gradle.kts",
      "kind": "configuration",
      "owner": "android",
      "condition": "has_android"
    },
    {
      "path": "android/app/build.gradle.kts",
      "kind": "configuration",
      "owner": "android",
      "condition": "has_android"
    },
    {
      "path": "android/app/src/main/AndroidManifest.xml",
      "kind": "configuration",
      "owner": "android",
      "condition": "has_android"
    },
    {
      "path": "android/app/src/main/java/app/MainActivity.kt",
      "kind": "source",
      "owner": "android",
      "condition": "has_android"
    }
  ],
  "conditional_directories": [
    {
      "condition": "has_integrations",
      "directories": [
        "integrations"
      ]
    },
    {
      "condition": "has_android",
      "directories": [
        "android"
      ]
    }
  ],
  "ownership": {
    "default": "deny",
    "agents": {
      "analysis": {
        "paths": [
          "requirements.json",
          "questions.json",
          "docs/system-analysis.md"
        ],
        "directories": []
      },
      "architecture": {
        "paths": [
          "architecture.json",
          "data-model.json",
          "ui-spec.json",
          "generation-plan.json"
        ],
        "directories": [
          "contracts"
        ]
      },
      "frontend": {
        "paths": [],
        "directories": [
          "frontend"
        ]
      },
      "backend": {
        "paths": [],
        "directories": [
          "backend/src"
        ]
      },
      "migrations": {
        "paths": [],
        "directories": [
          "backend/migrations"
        ]
      },
      "integrations": {
        "paths": [],
        "directories": [
          "integrations"
        ]
      },
      "documentation": {
        "paths": [
          "README.md",
          "docs/product.md",
          "docs/architecture.md",
          "docs/data-model.md",
          "docs/user-guide.md",
          "docs/development-guide.md",
          "docs/limitations.md"
        ],
        "directories": []
      },
      "assembly": {
        "paths": [
          "manifest.json",
          "traceability.json",
          ".gitignore"
        ],
        "directories": []
      },
      "android": {
        "paths": [],
        "directories": [
          "android"
        ]
      },
      "verification": {
        "paths": [
          "compose.yaml",
          ".env.example",
          ".gitlab-ci.yml"
        ],
        "directories": [
          "tests",
          "verification"
        ]
      }
    }
  },
  "limits": {
    "run": {
      "max_active_runs_per_user": 1,
      "max_calls": 60,
      "max_input_tokens": 300000,
      "max_output_tokens": 180000,
      "timeout_seconds": 3600,
      "max_automatic_retries_per_stage": 2,
      "max_clarification_rounds": 2,
      "max_critical_questions_per_round": 3
    },
    "agent": {
      "max_calls": 10,
      "max_output_tokens": 30000,
      "timeout_seconds": 600,
      "max_critical_questions": 3
    },
    "model_call": {
      "timeout_seconds": 120
    },
    "artifacts": {
      "max_files": 500,
      "max_file_bytes": 1048576,
      "max_total_bytes": 26214400,
      "max_path_length": 512
    }
  },
  "ui_kit": {
    "name": "Bootstrap",
    "theme_path": "frontend/src/styles.scss",
    "required_states": [
      "loading",
      "empty",
      "error",
      "forbidden",
      "success"
    ],
    "responsive_widths_px": [
      360,
      768,
      1280
    ]
  },
  "rules_document": "README.md"
}
